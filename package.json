{
  "name": "candyblast",
  "private": true,
  "version": "0.1.0",
  "description": "CandyBlast — video wish-duel roulette Telegram Mini App",
  "workspaces": [
    "packages/*",
    "apps/game",
    "apps/server"
  ],
  "scripts": {
    "test": "npm run test --workspace @candyblast/engine",
    "dev": "npm run dev --workspace @candyblast/game",
    "build": "npm run build --workspace @candyblast/game",
    "start": "npm start --workspace @candyblast/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": "22.x"
  }
}
